<Window x:Class="NetSpeedBar.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NetSpeedBar" Width="520" Height="390" WindowStartupLocation="CenterScreen">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="NetSpeedBar" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,24,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="外部ダウンロード" Foreground="Gray"/><TextBlock x:Name="DownloadText" FontSize="24" Text="未測定"/><TextBlock Text="前回値・測定種別と日時を常に併記します" TextWrapping="Wrap" Foreground="Gray"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="HTTP 往復時間" Foreground="Gray"/><TextBlock x:Name="QualityText" FontSize="24" Text="未監視"/><TextBlock x:Name="TimestampText" Foreground="Gray" TextWrapping="Wrap"/></StackPanel>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal"><Button x:Name="QualityButton" Padding="14,7" Margin="0,0,8,0" Click="QualityButton_Click" Content="品質を確認"/><Button x:Name="EstimateButton" Padding="14,7" Click="EstimateButton_Click" Content="軽量推定（手動）"/></StackPanel>
  </Grid>
</Window>
